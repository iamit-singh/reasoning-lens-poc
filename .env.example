# C8 configuration. Copy to .env; never commit real secrets (B7.1).
# REDIS_URL and LANGFUSE_* come from AWS Secrets Manager in prod.

DEMO_MODE=live                  # cached = serve cache + panel only, zero LLM spend (the B7.4 kill switch)
MOCK_LLM=1                      # 1 = replay cassettes. Default for local dev and CI.

# Exact dated model ids. NEVER a floating alias (C2.3, G0 check 4).
# Filled in by S1 / ADR-001-provider.md -- deliberately blank until G0 passes.
MODEL_PIN=
MODEL_TRIAGE=
MODEL_ESCALATE=

THINKING_BUDGET_TOKENS=8000     # arm 2 budget; whether it bound is recorded in the report
ESCALATION_MAX_STEPS=8
ANALYSIS_DEADLINE_S=110         # past it, escalation is skipped and the report is degraded (C11)
ARM_TIMEOUT_S=75
RATE_LIMIT_PER_IP_HOUR=6

SPEND_ALARM_USD=130
SPEND_BREAKER_USD=150

ALLOWED_FRAME_ANCESTORS=https://talentica.com
REDIS_URL=redis://localhost:6379/0
