# Configuration. Copy to .env; never commit real keys.
# Amended by ADR-001 (hybrid runtime) and ADR-003 (local-only demo).

DEMO_MODE=live                  # cached = serve cache + panel only. Now the DEMO-SAFETY
                                # switch: a guaranteed zero-dependency run when the network
                                # or the key is unavailable.
MOCK_LLM=1                      # 1 = replay cassettes. Default for local dev and CI.

ANALYZER_BACKEND=hybrid         # hybrid = local generates, OpenAI analyses (default)
                                # local  = everything local, no API. Both are measured and
                                #          reported; see ADR-001.

# ---------------------------------------------------------------- generation (local)
# All three arms MUST use the same model. Different models per arm would measure vendors
# instead of reasoning strategies, and the finding evaporates. See ADR-001.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=gpt-oss:20b
LOCAL_REASONING_EFFORT=medium   # ARM 2's effort. low | medium | high.
                                # Arm 1's is `low`, fixed in code (rlens.runner.arms.
                                # DIRECT_EFFORT) -- it is a property of the experiment,
                                # not a deployment knob. See ADR-004.
                                #
                                # THINKING CANNOT BE TURNED OFF on gpt-oss:20b, and the
                                # two switches that claim to are SILENTLY IGNORED:
                                # `reasoning_effort: none` and ollama's native
                                # `think: false` both return a full 2918-char trace.
                                # `low` is honoured (131 chars). Arm 1 is therefore a
                                # MINIMAL-reasoning baseline, not a zero-reasoning one.

# The local pin is a TUPLE, not an id -- an id does not reproduce a number (ADR-001).
# Every field travels with the report and enters the cache key.
#
# THE VALUES BELOW ARE THE SHIPPING PINS, not examples. The committed cassettes were
# recorded at them, so `make spans && make report` replays the published demo only with
# these exact values. Left blank (as they were until the 28 Sep close-out), a fresh clone
# built 42 arms of `analysis_unavailable` and nothing said why. None of them is a secret.
LOCAL_MODEL_DIGEST=sha256:e7b273f9636059a689e3ddcab3716e4f65abe0143ac978e46673ad0e52d09efb
                                # exact model artifact digest; filled by `make pin-local`
LOCAL_MODEL_SHORT_ID=17052f91a42e
LOCAL_QUANTIZATION=MXFP4
LOCAL_RUNTIME="ollama 0.33.3"    # e.g. "ollama 0.33.3". QUOTE IT -- the value contains a
                                # space, and unquoted it truncates when .env is sourced.
GEN_TEMPERATURE=0
GEN_TOP_P=1.0
GEN_SEED=20260910

# Tokenizer for local reasoning-token counting (G0 check 2). The runtime reports
# completion_tokens for reasoning AND answer combined and no reasoning_tokens, so the
# split is counted locally -- exactly, with the model's own encoding. Part of the pin:
# a model swap without a tokenizer swap produces a plausible wrong number.
LOCAL_TOKENIZER=o200k_harmony   # gpt-oss. The qwen3 fallback needs a different encoding.

# ---------------------------------------------------------------- analysis (OpenAI)
# Pinned separately from generation: the two move independently.
OPENAI_API_KEY=
MODEL_ANALYZE=gpt-5-mini-2025-08-07    # exact dated id, never an alias. Classifier + triage.
                                # Pinned 11 Sep 2026: gpt-5-mini-2025-08-07 (ADR-001 G0#5).
MODEL_ESCALATE=gpt-5-2025-08-07        # exact dated id. Must be STRONGER than MODEL_ANALYZE --
                                # the escalation tier is meaningless otherwise (ADR-001).
                                # Pinned 11 Sep 2026: gpt-5-2025-08-07.

# S3's three consequences for every analysis call, as config rather than as folklore.
# The cap is asserted from the OUTPUT (finish_reason), never from the request being
# accepted -- that is the rule this project has now re-learned five times.
ANALYZE_REASONING_EFFORT=low    # classification is a labelling task, not a deliberation
                                # one. At default effort a 25-step batch spent its whole
                                # budget in the reasoning channel and returned EMPTY
                                # content while billing 2,293 tokens (S3 failure mode 1).
ANALYZE_MAX_OUTPUT_TOKENS=16000 # explicit and asserted. `length` is a HARD ERROR, not a
                                # parse failure to retry -- retrying a truncation just
                                # truncates again (S3 consequence 1).
CLASSIFY_CHUNK_SIZE=25          # C4.3's batch, as a CAP not a fixed size. Traces run 2 to
                                # 141 steps (S3 -S1): chunk and stitch on step_id.

THINKING_BUDGET_TOKENS=8000
ESCALATION_MAX_STEPS=8
ANALYSIS_DEADLINE_S=180         # was 110, and 110 was never enforced: M1-9 measured a
                                # single call taking 969s against it, because urlopen's
                                # timeout bounds socket operations and the block was
                                # inside the call. Now enforced as a wall-clock budget.
                                # 180 sits above the legitimate worst case (a 25-step
                                # chunk with 125 steps of context, ~100s) and far below
                                # the pathology. C11 budgets 18s; see the M1-9 write-up.
ARM_TIMEOUT_S=180               # was 75. Local generation is slower per token; a
                                # reasoning-heavy problem may take 30-90 s per arm.

SPEND_ALARM_USD=5               # was 130. Generation is free now; analysis is a few dollars.
SPEND_BREAKER_USD=10            # was 150. Vestigial guard against a runaway loop.

SPEND_FILE=                     # default out/spend.json. The breaker is a FILE, not a
                                # service (ADR-011): an unreadable total fails CLOSED.
CACHE_STRICT=1                  # refuse to start on a cache built by a different
                                # pipeline. 0 serves it anyway - which is a decision to
                                # publish numbers attributed to a system not running.

# ---------------------------------------------------------------- telemetry (Appendix D #6)
# Langfuse cloud free tier. All content is team-authored, so B6.4 holds -- no visitor
# data exists to leak. The runner exports the SAME spans the analyzer reads, over OTLP,
# as one more span processor: a second SDK would let the dashboard and the report drift
# and give no way to tell which number was wrong.
#
# Unset keys are NOT an error -- CI and offline dev run without telemetry. The runner
# prints the export status on every run, because a silently-absent sink looks exactly
# like an idle one.
LANGFUSE_ENABLED=1
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Deleted by ADR-003 (local-only demo): RATE_LIMIT_PER_IP_HOUR, ALLOWED_FRAME_ANCESTORS.
# No public URL, no anonymous visitor, no iframe embed.

# ---------------------------------------------------------------- judge tiers (M2-5, M2-8)
# Both default OFF in code. These lines are the SHIPPING configuration and each one is a
# measured decision recorded in ADR-012, not a preference.
#
# CONSISTENCY_ENABLED=1 -- M2-8's DoD is a MEASURED false-positive rate on the known-good
#   pool before the check is shown to anyone (B10). It is measured: 0 false flags of 5,
#   zero citation downgrades. So it ships on.
#
# ESCALATION_ENABLED=0 -- measured and DECLINED. Over the same ten seeded errors the tier
#   took recall from 8/10 to 7/10 for 10 extra frontier calls: 15 steps selected, 5
#   verdicts changed, ZERO detections gained, one lost. `escalate.md` is written to prefer
#   `sound` on terse-but-correct steps -- correct, and on deliberately-defective text that
#   same bias turns hits into misses. Trigger t9, published rather than quietly dropped.
#   Turning it on is one flag and does not touch the frozen bundle.
CONSISTENCY_ENABLED=1
ESCALATION_ENABLED=0
